{
  "entities": {
    "Action": {
      "displayLabel": "name",
      "filePattern": "actions*.json",
      "icon": "Zap",
      "primaryKey": "id"
    },
    "Object": {
      "displayLabel": "name",
      "filePattern": "objects*.json",
      "icon": "Box",
      "primaryKey": "id"
    },
    "Rule": {
      "displayLabel": "name",
      "filePattern": "logic_rules*.json",
      "icon": "BookOpen",
      "primaryKey": "id"
    }
  },
  "items_field": "items",
  "kind_field": "kind",
  "relations": [
    {
      "path": "target_objects[*]",
      "source_kind": "Action",
      "target_kind": "Object"
    },
    {
      "path": "inputs[*].reference_to",
      "source_kind": "Action",
      "strategy": "split_by_dot_first_segment",
      "target_kind": "Object"
    }
  ]
}
